# Frontend environment variables — copy to .env and fill in values
# NEVER commit the actual .env file to version control

# ── Backend API URL ──────────────────────────────────────
# For local development, leave empty (Vite proxy handles it)
# For production, set to your Render backend URL:
# Example: https://accessibility-assistant-api.onrender.com
VITE_API_URL=
