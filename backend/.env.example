# Environment variables — copy to .env and fill in values
# NEVER commit the actual .env file to version control

# ── Required ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional (used in production only) ───────────────────────
# URL of your deployed Vercel frontend (no trailing slash)
# Example: https://accessibility-assistant.vercel.app
FRONTEND_URL=

# Port for the Flask dev server (defaults to 5000 if not set)
PORT=5000

# ── Auth (Google + GitHub) ────────────────────────────────
# Secret used to sign login tokens (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_string

# Public URL of this API (needed for GitHub OAuth callback).
# Local: http://localhost:5000
# Render: https://your-service.onrender.com
BACKEND_PUBLIC_URL=http://localhost:5000

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Authorized JavaScript origins: http://localhost:5173 and your Vercel URL
GOOGLE_CLIENT_ID=

# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: http://localhost:5000/auth/github/callback
# Production callback: https://your-api.onrender.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
